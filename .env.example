# Copy to .env (outside public/). Keep credentials out of source control.
APP_ENV=production
APP_URL=https://voicemail.example.com
NS_API_URL=https://nms1.nyc.birns.net/ns-api/v2
NS_API_TOKEN=
# Generate three DIFFERENT random secrets. APP_KEY >=32 chars; access keys >=24.
APP_KEY=
BROWSER_ACCESS_KEY=
WEBRESPONDER_KEY=
# Shared-key holders can access ONLY these exact mailboxes (comma-separated).
ALLOWED_MAILBOXES=6001@1180.DynaCloud
# Signed upstream audio URLs must be HTTPS on these exact lowercase hosts.
MEDIA_ALLOWED_HOSTS=nms1.nyc.birns.net
FFMPEG_BIN=ffmpeg
# On Windows, prefer an absolute path (forward slashes work in PHP):
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# Phone-only WAV codec. Leave PCM as default unless testing core compatibility.
# If voicemail screeches on the phone at 1x but browser audio is clear, try pcm_mulaw.
# Allowed: pcm_s16le (16-bit PCM), pcm_mulaw (G.711 mu-law), pcm_alaw (G.711 A-law).
PHONE_AUDIO_CODEC=pcm_s16le
# Enable ONLY after confirming DELETE on new/save moves to trash on your server.
# DELETE on trash is always prohibited by this app.
NS_DELETE_MOVES_TO_TRASH=false
# Optional absolute private directory (default: project/var)
# STORAGE_PATH=/var/lib/vmplayback
